# Copy to .env and fill in. `.env` is gitignored.

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Financial guardrails on offer_settlement/create_payment_link (discount
# ceiling, installment cap, escalation threshold). Set to "off" to see the
# exact failure mode these prevent -- ships "on" by default, unlike
# PaySentry's Stage 1, which shipped unguarded on purpose.
CLEARDUE_GUARDRAILS=on

# Invoice-binding + consent checks on every tool. Set to "off" to see a
# session act on another customer's invoice, or message someone who
# withdrew consent.
CLEARDUE_AUTHZ=on

CLEARDUE_PORT=8000

# --- Vercel deployment only, all optional for local dev -------------------
# REDIS_URL (redis:// or rediss://) or KV_REST_API_URL + KV_REST_API_TOKEN
# (Upstash REST) switches session/ledger storage from in-memory to Redis --
# required once this runs as a serverless function. See agent/store.py.
# REDIS_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Requires a matching X-Debug-Token header on POST /debug/reset only, so a
# public deployment can't be wiped mid-demo by a random visitor. Leave unset
# locally.
# DEBUG_TOKEN=

# /chat rate limits -- protects the real OpenAI key behind a public demo
# link from unbounded spend. Defaults below are generous for one person
# demoing; tighten if the link is going somewhere public. See
# agent/rate_limit.py.
# RATE_LIMIT_PER_IP=20
# RATE_LIMIT_WINDOW_SECONDS=300
# RATE_LIMIT_DAILY_CAP=300

# Real Razorpay Payment Links API. Use TEST MODE keys (Dashboard -> Settings
# -> API Keys, no KYC needed) -- rzp_test_ key id, no real money moves.
# Unset: create_payment_link falls back to a fake pay.cleardue.test URL,
# same as every phase before this one. See agent/razorpay_client.py.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- MCP policy gateway ---------------------------------------------------
# "on" gives the agent Razorpay's MCP tool catalog, with every tools/call
# routed through mcp_gateway/ and policy_engine/ first. Needs the Razorpay
# keys above. Off by default so the repo still clones and runs with nothing
# configured. See mcp_gateway/gateway.py.
# CLEARDUE_MCP=on
#
# Which MCP server to talk to. Unset launches the bundled razorpay_mcp
# server over stdio. Razorpay's hosted server is https://mcp.razorpay.com/mcp
# but it requires an interactive OAuth token -- API-key bearer tokens are
# rejected with OAUTH_BAD_TOKEN, despite what the README documents. Put an
# obtained token in CLEARDUE_MCP_AUTH as "Bearer <token>".
# CLEARDUE_MCP_URL=
# CLEARDUE_MCP_AUTH=
#
# Gateway limits (paise). Defaults: 700,000.00 per link; 12 calls and
# 2,000,000.00 total per hour.
# CLEARDUE_MCP_MAX_LINK_PAISE=70000000
# CLEARDUE_MCP_BUDGET_CALLS=12
# CLEARDUE_MCP_BUDGET_PAISE=200000000
#
# Append-only log of every HTTP request the bundled MCP server actually
# makes. This is what proves a blocked call never reached the API -- a
# denial that leaves no receipt was stopped pre-execution.
# RAZORPAY_MCP_RECEIPTS=./reports/mcp_receipts.jsonl
